# better-sqlite3 ships prebuilt binaries inside its package. Without this, npm falls back to
# `node-gyp rebuild` (needs python/make/g++ and a network fetch of Node headers) and the install fails
# on machines without a C++ toolchain. The only other package with an install script is the optional
# macOS file watcher `fsevents`, which also ships a prebuilt binary.
ignore-scripts=true
